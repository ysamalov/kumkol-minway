# Файл .env для настройки переменных окружения
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=minwaykumkoldb

# Параметры OpenRouter
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=stepfun/step-3.5-flash:free

# ── Скорость техники ───────────────────────────────────────────────────────────
DEFAULT_SPEED_KMH=40.0
MIN_SPEED_KMH=1.0
MAX_SPEED_KMH=150.0
 
# ── Рекомендации ──────────────────────────────────────────────────────────────
TOP_N_RECOMMENDATIONS=3
 
# ── Смены ─────────────────────────────────────────────────────────────────────
SHIFT_HOURS=12
DAY_SHIFT_START=8
NIGHT_SHIFT_START=20
 
# ── SLA дедлайны (часов от planned_start) ─────────────────────────────────────
SLA_HIGH_HOURS=2.0
SLA_MEDIUM_HOURS=5.0
SLA_LOW_HOURS=12.0
 
# ── Веса скоринга (сумма должна быть 1.0) ─────────────────────────────────────
SCORE_W_DIST=0.35
SCORE_W_WAIT=0.25
SCORE_W_IDLE=0.10
SCORE_W_PRIO=0.20
SCORE_W_COMPAT=0.10
SCORE_DIST_REFERENCE_KM=50.0
 
# ── Мультизадача ──────────────────────────────────────────────────────────────
MULTITASK_MAX_TIME_MINUTES=480
MULTITASK_MAX_DETOUR_RATIO=1.3
 
# ── VRP solver ────────────────────────────────────────────────────────────────
VRP_DEFAULT_TIME_LIMIT_SEC=10
VRP_MEDIUM_TW_CAP_MINUTES=480
VRP_PENALTY_HIGH=100000
VRP_PENALTY_MEDIUM=50000
VRP_PENALTY_LOW=10000
 
# ── Совместимость техники ──────────────────────────────────────────────────────
# false = мягкая (несовместимость штрафуется, но не блокирует назначение)
# true  = строгая (машина не назначается на несовместимый тип работ)
STRICT_COMPATIBILITY=false

# ── ограничения на количество задач в запросе ─────────────────────────────────────
MAX_MULTITASK_TASKS=200   # для /api/multitask
MAX_VRP_TASKS=200        # для /api/optimize
# ── VRP техника ────────────────────────────────────────────────────────────────
VRP_MAX_VEHICLES=30          # топ-N ближайших машин для OR-Tools
VRP_MAX_GROUP_SIZE=5         # макс. заявок в одной мультизадаче

# ── Таймауты (секунды) ─────────────────────────────────────────────────────────
TIMEOUT_DISTANCE_MATRIX=20.0
TIMEOUT_ROUTE=5.0
TIMEOUT_GROUPING=15.0
TIMEOUT_RECOMMEND=10.0

# ── Граф дорог ────────────────────────────────────────────────────────────────
ROAD_GRAPH_CACHE_SIZE=8192   # LRU-кэш кратчайших путей

# ── Аналитика скоростей ────────────────────────────────────────────────────────
ANALYTICS_SPEED_FLOOR=0.3    # порог «машина стоит» (км/ч)
ANALYTICS_SPEED_CEIL=130.0   # верхний фильтр выбросов скорости
VRP_MAX_DISTANCE_KM=150.0    # машины дальше этого порога не участвуют в VRP